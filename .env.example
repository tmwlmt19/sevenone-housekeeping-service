# Database (Neon) — async driver
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# Separate Neon branch used for the test suite
TEST_DATABASE_URL=postgresql+asyncpg://user:password@host/dbname_test

# JWT — use a unique random secret per environment.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Session cookie (SSO). Locally the defaults work over http on localhost.
# In a deployed env set COOKIE_DOMAIN to the shared parent domain so the cookie
# is sent to login./app./admin./api. subdomains, and COOKIE_SECURE=true (https).
SESSION_COOKIE_NAME=sevenone_session
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS — comma-separated allowed origins: hotel app (5173), login app (5174),
# admin app (5175). In a deployed env list that env's https origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Email / password reset. Leave RESEND_API_KEY blank in dev — sends become a
# logged no-op (the reset URL is printed to the server log). Set it in prod to
# actually deliver mail. EMAIL_FROM must be on a Resend-verified domain.
RESEND_API_KEY=
EMAIL_FROM=SevenOne <no-reply@send.sevenone.com>
# Login-app route that renders the reset form (prod: https://login.sevenone.com/reset-password)
PASSWORD_RESET_URL_BASE=http://localhost:5174/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_MIN_INTERVAL_SECONDS=60
